# Template para ambiente de Staging
# Copie este arquivo para .env.staging e preencha os valores reais.
# .env.staging NÃO deve ser commitado (ver .gitignore).

DB_USER=staging_user
DB_PASSWORD=staging_password
DB_NAME=sge_staging

JWT_SECRET=super_secret_staging_key_min_32_chars_here
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3000
SEED_ADMIN_PASSWORD=admin_staging_123

# PORT: porta interna em que o NestJS escuta dentro do container.
# Default no env.validation.ts: 3000. Deve coincidir com EXPOSE 3000 do Dockerfile
# e com o mapeamento ports: 3000:3000 do docker-compose.staging.yml.
PORT=3000

NEXT_PUBLIC_API_URL=http://localhost:3000
