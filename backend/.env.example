# ==============================================================================
# SGE FORTAL - Configurações de Ambiente
# Copie este arquivo para .env e preencha os valores reais.
# NUNCA comite o arquivo .env no repositório.
# ==============================================================================

# 1. Banco de Dados PostgreSQL (Obrigatório)
# Em staging/produção, use o host do serviço de banco (ex: db no docker-compose, ou RDS endpoint)
DATABASE_URL="postgresql://SEU_USUARIO:SUA_SENHA@SEU_HOST:5432/SEU_BANCO?schema=public"

# 2. Redis / Filas Assíncronas (BullMQ) (Obrigatório)
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379

# 3. Autenticação e Segurança (Obrigatório)
# JWT_SECRET: use uma chave forte e aleatória (mínimo 64 caracteres).
# Gere com: openssl rand -hex 64
# EM HIPÓTESE ALGUMA use o valor de exemplo em staging/produção.
JWT_SECRET="SUBSTITUA_POR_UMA_CHAVE_FORTE_E_ALEATORIA_64_CHARS"
JWT_EXPIRATION="15m"

# 4. Aplicação / API
PORT=3000

# 5. CORS — Origens permitidas (Obrigatório em staging/produção)
# Lista separada por vírgulas. NUNCA use wildcard (*) com credentials: true.
# Exemplo dev:     ALLOWED_ORIGINS="http://localhost:3001"
# Exemplo staging: ALLOWED_ORIGINS="https://staging.sge-fortal.com.br,https://app.sge-fortal.com.br"
ALLOWED_ORIGINS="http://localhost:3001"

# 6. Seed do Banco de Dados (ADR-0008, Decisão 3)
# Senha inicial do usuário ADMIN criada pelo "npx prisma db seed".
# - Em development (NODE_ENV=development ou ausente): variável OPCIONAL.
#   Se ausente, usa senha padrão de conveniência com console.warn() explícito.
# - Em qualquer outro ambiente (staging, production): variável OBRIGATÓRIA.
#   O seed falha explicitamente se ausente, sem criar Admin com senha conhecida.
# Gere com: openssl rand -base64 32
SEED_ADMIN_PASSWORD="SUBSTITUA_POR_SENHA_FORTE_E_ALEATORIA_EM_STAGING"
